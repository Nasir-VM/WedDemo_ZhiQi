# 複製為 .env 後填入正式值，.env 不可提交進版控
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
SECURE_SSL_REDIRECT=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,erp.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://erp.example.com
DJANGO_TIME_ZONE=Asia/Taipei
COMPANY_NAME=志氣企業

SQLITE_PATH=/data/db.sqlite3
MEDIA_ROOT=/data/media
BACKUP_DIR=/data/backups

ADMIN_URL_PATH=ops-console-7f3a
ADMIN_ALLOWED_IPS=127.0.0.1
TRUST_CF_CONNECTING_IP=True

EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
LOG_LEVEL=INFO

# Cloudflare Tunnel（docker compose 使用 token 模式）
CLOUDFLARE_TUNNEL_TOKEN=

# 首次啟動可設定；建立後建議從 .env 移除。留空則不自動建立管理員。
DJANGO_ADMIN_USERNAME=admin
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
